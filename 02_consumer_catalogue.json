{
 "schema_version": 1,
 "title": "GenTwin-SG consumer and appliance catalogue",
 "purpose": "Supplies every quantity Eq. (2) needs: n_{h,a}, P^rat_a, epsilon_a, u_{h,a}(t) and f_a(Theta(t)), for six consumer categories.",
 "provenance": {
  "duty_cycles": "LITERATURE / SCENARIO. epsilon_a is the fraction of rated power actually drawn while the appliance is nominally on: near 1.0 for resistive loads, well below 1.0 for thermostatically cycled ones.",
  "schedules": "SCENARIO. No metered end-use survey exists for Dhaka. Schedules encode documented occupancy patterns for each category and are the single largest modelling assumption in Stage A/B. They are stated here explicitly rather than buried in code so they can be challenged.",
  "class_assignment": "Follows the brief: C = {critical, shiftable, curtailable}. Critical = cannot be interrupted without harm or spoilage. Shiftable = the task must happen but its timing is free. Curtailable = can be reduced in intensity at a comfort cost.",
  "thermal_response": "f_a(Theta) forms in `thermal_responses` below. Only cooling and refrigeration loads respond to temperature; everything else has f_a == 1.",
  "appliance_ratings_kw": "LITERATURE / manufacturer nameplate. Bangladeshi retail market typicals (Walton, Vision, Singer, Gree) for residential; ASHRAE and IEEE 3001 connected-load densities scaled to floor area for non-residential.",
  "daily_hours": "LITERATURE / SCENARIO. Anchored so that archetype mean monthly consumption lands in the published Dhaka residential range (100-450 kWh/month). Calibrated per archetype, NOT by a uniform scaling of all households."
 },
 "notes": {
  "units": "P_rat_kw in kW, matching P^rat_a of Eq. (2). The formulation's section 1.2 gives kW; no conversion is applied anywhere.",
  "u_h_a": "u_{h,a}(t) is BINARY, as Eq. (2) states. Each household samples its OWN on/off pattern: `daily_hours` sets how long the appliance runs, and the schedule's level acts as the PROBABILITY that a given slot is one of the ON slots. Two households with the same appliances therefore run them at different hours, which is what produces a realistic coincidence factor. Where daily_hours is null the schedule's own implied hours are used (non-residential, already plausible).",
  "critical_never_curtailed": "Hospital loads are NOT excluded by rule. They sit in the ordinary classes and are kept out of curtailment by the Proposition 2 threshold, via lambda_g = 0.02 and gamma^cu_g = 5000 in config.CONSUMER_TIERS.",
  "preferences": "Preferences are NOT stored here. The revised formulation carries lambda_h, gamma^sh_h, gamma^cu_h per HOUSEHOLD (section 1.3, Remark 4), so each consumer samples its own from config.CONSUMER_ARCHETYPES at synthesis time. The archetype names below are a generator only.",
  "simultaneity": "Fraction of owned units drawing power at once. A household with three ACs rarely runs all three together; without this the multiplicity n_{h,a} overstates demand."
 },
 "thermal_responses": {
  "none": {
   "form": "f_a(Theta) = 1",
   "beta_per_c": 0.0,
   "theta_ref_c": null,
   "cap": 1.0,
   "comment": "No temperature sensitivity."
  },
  "cooling_ac": {
   "form": "f_a(Theta) = clip(1 + beta * (Theta - theta_ref)_+, 1, cap)",
   "beta_per_c": 0.06,
   "theta_ref_c": 24.0,
   "cap": 1.75,
   "comment": "Compressor duty rises with the indoor-outdoor gradient. 6%/C above a 24 C setpoint reaches the 1.75 cap around 36.5 C, which is about the hottest Dhaka gets. This coefficient is what produces the afternoon load rise, so it materially affects peak timing."
  },
  "cooling_fan": {
   "form": "f_a(Theta) = clip(1 + beta * (Theta - theta_ref)_+, 1, cap)",
   "beta_per_c": 0.03,
   "theta_ref_c": 26.0,
   "cap": 1.3,
   "comment": "Fans do not modulate power much; the effect is mostly more units switched on, which the schedule also carries. Kept deliberately weaker than AC."
  },
  "refrigeration": {
   "form": "f_a(Theta) = clip(1 + beta * (Theta - theta_ref)_+, 1, cap)",
   "beta_per_c": 0.02,
   "theta_ref_c": 22.0,
   "cap": 1.3,
   "comment": "Ambient heat gain into the cabinet raises compressor duty. Applies to domestic fridges, retail display refrigeration and medical cold chain."
  }
 },
